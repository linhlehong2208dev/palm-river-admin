# Supabase project used by the Admin Google OAuth login
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Canonical URL of this Admin app. Add the same URL to Supabase Auth's redirect URL allowlist.
VITE_APP_URL=https://admin.canho-palmriver.vn

# URL of the EXISTING API/Worker project. This Admin project does not deploy or modify it.
# Example: https://your-existing-worker.your-account.workers.dev
VITE_API_BASE=https://YOUR_EXISTING_WORKER_URL
